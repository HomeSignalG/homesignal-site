  { "id": "R2-oakland-accela-aca",
    "url": "https://aca-prod.accela.com/OAKLAND/Default.aspx",
    "extract": "(?i)<title>[^<]{0,120}</title>", "extract_context": 0, "extract_max": 2 },

  { "id": "R2-berkeley-permits-portal",
