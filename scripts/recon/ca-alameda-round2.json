[
  { "id": "R2-oakland-socrata-COUNT",
    "url": "https://api.us.socrata.com/api/catalog/v1?domains=data.oaklandca.gov&q=permit&limit=1",
    "extract": "\"resultSetSize\"\\s*:\\s*\\d+", "extract_context": 5, "extract_max": 2 },

  { "id": "R2-oakland-socrata-DENOMINATOR",
    "url": "https://api.us.socrata.com/api/catalog/v1?domains=data.oaklandca.gov&only=dataset&limit=1",
    "extract": "\"resultSetSize\"\\s*:\\s*\\d+", "extract_context": 5, "extract_max": 2 },

  { "id": "R2-oakland-socrata-NAMES",
    "url": "https://api.us.socrata.com/api/catalog/v1?domains=data.oaklandca.gov&q=permit&limit=60",
    "extract": "\"name\"\\s*:\\s*\"[^\"]{0,90}\"", "extract_context": 0, "extract_max": 60 },

  { "id": "R2-berkeley-socrata-COUNT",
    "url": "https://api.us.socrata.com/api/catalog/v1?domains=data.cityofberkeley.info&q=permit&limit=1",
    "extract": "\"resultSetSize\"\\s*:\\s*\\d+", "extract_context": 5, "extract_max": 2 },

  { "id": "R2-berkeley-socrata-DENOMINATOR",
