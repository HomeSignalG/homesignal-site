    "extract": "\"resultSetSize\"\\s*:\\s*\\d+", "extract_context": 5, "extract_max": 2 },

  { "id": "R2-berkeley-socrata-NAMES",
    "url": "https://api.us.socrata.com/api/catalog/v1?domains=data.cityofberkeley.info&q=permit&limit=60",
    "extract": "\"name\"\\s*:\\s*\"[^\"]{0,90}\"", "extract_context": 0, "extract_max": 60 },

  { "id": "R2-oakland-ownGIS-root",
    "url": "https://services2.arcgis.com/i5nQGujUeSmQZAbW/ArcGIS/rest/services?f=json",
    "extract": "\"name\"\\s*:\\s*\"[^\"]{0,70}\"", "extract_context": 0, "extract_max": 80 },

  { "id": "R2-oakland-AGO-orgsearch",
